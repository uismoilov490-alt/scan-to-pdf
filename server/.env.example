# Nusxa oling: cp .env.example .env  — keyin qiymatlarni to'ldiring.
PORT=4100
HOST=127.0.0.1
DB_PATH=./data/scan.db

FIREBASE_PROJECT_ID=scan-to-pdf-7fdf1

# Anthropic Console → "scan-to-pdf" workspace → API Keys
ANTHROPIC_API_KEY=
OCR_MODEL=claude-sonnet-5-5
NAME_MODEL=claude-haiku-4-5

# Bepul: kuniga shuncha AI fayl (bitta faylda eng ko'pi FREE_FILE_MAX_PAGES sahifa)
FREE_DAILY_FILES=5
FREE_FILE_MAX_PAGES=20
# Oylik tarif: oyiga AI sahifalar
MONTHLY_UNITS=100
NAME_DAILY_CAP=50

# Google Play Console → service account JSON (ilova Play'ga chiqqanda)
PLAY_SERVICE_ACCOUNT_FILE=
ANDROID_PACKAGE=uz.myhujjat.scan_to_pdf

# Sinov uchun Pro beriladigan Firebase UID'lar (vergul bilan)
DEV_PRO_UIDS=

# Tarjima (1 birlik = shuncha belgi; bitta so'rovdagi matn chegarasi)
TRANSLATE_MODEL=claude-sonnet-5-5
TRANSLATE_CHARS_PER_UNIT=4000
TRANSLATE_MAX_CHARS=20000
